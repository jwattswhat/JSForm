{
    "frmReportsFORM": {
        "FORM": {
            "name": "frmReports",
            "type": "Panel",
            "title": "frmReports: Church Manager - Report Menu",
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                45,
                40
            ],
            "stylelist": [
                "CAPTION"
            ]
        },
        "CONTROLS": {
            "lblReports": {
                "name": "lblReports",
                "type": "StaticText",
                "posch": [
                    1,
                    4
                ],
                "label": "Report:"
            },
            "ReportID": {
                "name": "ReportID",
                "type": "ComboBox",
                "posch": [
                    7,
                    4
                ],
                "lookupchoices": {
                    "name": "tblReports",
                    "fields": [
                        "ID",
                        "Title",
                        "CONCAT('(',Report,')')"
                    ],
                    "orderby": "Title"
                },
                "action": [
                    "onchange",
                    "enablebuttons"
                ]
            },
            "ParameterBox": {
                "name": "ParameterBox",
                "type": "StaticBox",
                "posch": [
                    1,
                    8
                ],
                "sizech": [
                    42,
                    12
                ],
                "label": "Parameters"
            },
            "btnRun": {
                "name": "btnRun",
                "type": "Button",
                "label": "Run Report",
                "posch": [
                    35,
                    33
                ]
            }
        }
    }
}