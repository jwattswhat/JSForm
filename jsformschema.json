{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "possize":{
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ]
    },
    "tableproperties": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": [
            {
              "type": "string"
            }
          ]
        },
        "orderby": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "fields"
      ]
    },
    "formtype":{
      "type": "string",
      "enum": [
        "Panel",
        "Dialog",
        "Frame",
        "StaticBox"
      ]
    },
    "formstylelist": {
      "type": "array",
      "items": {
        "type":"string",
        "enum": ["CAPTION","READONLY"]}
    },
    "formsecurity": {
      "type": "object",
      "properties": {
        "open": {"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
        "create": {"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
        "update": {"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
        "delete": {"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
        "report": {"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"}
      },
      "additionalProperties": false
    },
    "controlsecurity": {
      "type": "object",
      "properties": {
        "view": {"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
        "edit": {"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"},
        "invoke": {"type":"string","pattern":"^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"}
      },
      "additionalProperties": false
    },
    "formproperties": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {"$ref":"#/definitions/formtype"},
        "title": {
          "type": "string"
        },
        "table": {"$ref":"#/definitions/tableproperties"},
        "security": {"$ref":"#/definitions/formsecurity"},
        "stylelist": {"$ref":"#/definitions/formstylelist"},
        "posch": {"$ref":"#/definitions/possize"},
        "sizech": {"$ref":"#/definitions/possize"},
        "pos": {"$ref":"#/definitions/possize"},
        "size": {"$ref":"#/definitions/possize"},
        "linkedform":{
            "type":"object",
            "patternProperties":{
              ".*":{"$ref":"#/definitions/linkedandsubform"}
            },
            "additionalProperties": true
        },
        "subform":{
          "type":"object",
          "patternProperties":{
            ".*":{"$ref":"#/definitions/linkedandsubform"}
          },
          "additionalProperties": true
        }
      },
      "required": ["name","type","title","posch","sizech"]
    },
    "linkedandsubform":{
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {"$ref":"#/definitions/formtype"},
        "title": {
          "type": "string"
        },
        "stylelist": {"$ref":"#/definitions/formstylelist"},
        "table": {"$ref":"#/definitions/tableproperties"},
        "posch": {"$ref":"#/definitions/possize"},
        "sizech": {"$ref":"#/definitions/possize"},
        "pos": {"$ref":"#/definitions/possize"},
        "size": {"$ref":"#/definitions/possize"}
      }
    }
  },
  "type": "object",
  "patternProperties": {
    ".*": {
      "type": "object",
      "properties": {
        "FORM": {"$ref": "#/definitions/formproperties"},
        "CONTROLS": {
          "type": "object",
          "patternProperties": {
            ".*":{
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum":[
                    "StaticBox",
                    "StaticText",
                    "MultiLine",
                    "TextCtrl",
                    "TextNumber",
                    "Currency",
                    "Float",
                    "JSON",
                    "ComboBox",
                    "ListCtrl",
                    "ListCtrlID",
                    "CheckBox",
                    "CheckListBox",
                    "CheckListEdit",
                    "Button",
                    "DataViewListCtrl",
                    "DateTime",
                    "DatePickerCtrl",
                    "TimePickerCtrl",
                    "CalendarCtrl",
                    "FilePickerCtrl",
                    "HTMLCtrl"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "tooltip": {
                  "type": "string",
                  "minLength": 1
                },
                "maxlength": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxlengthmessage": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string"
                },
                "posch": {"$ref":"#/definitions/possize"},
                "sizech":{"$ref":"#/definitions/possize"},
                "pos": {"$ref":"#/definitions/possize"},
                "size":{"$ref":"#/definitions/possize"},
                "stylelist": {
                  "type": "array",
                  "items": {
                    "type":"string",
                    "enum": [
                      "MULTILINE",
                      "DONTWRAP",
                      "WORDWRAP",
                      "READONLY",
                      "PROCESSENTER",
                      "PROCESSTAB",
                      "FLPCHANGEDIR",
                      "FLPSMALL",
                      "FLPUSETEXTCTRL",
                      "ALLOWNONE",
                      "DROPDOWN",
                      "MULTIPLE"
                    ] 
                  }
                },
                "lookupchoices":{"$ref":"#/definitions/tableproperties"},
                "security":{"$ref":"#/definitions/controlsecurity"},
                "action":{
                  "type": "array",
                  "items": [
                    {
                      "type":"string",
                      "enum": ["openlinkedform","refreshform","editchecklist","openfile","openreport","process","onchange"]
                    },
                    {"type":"string"}
                  ]
                }
              },
              "required": [
                "type",
                "name",
                "posch"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "FORM",
        "CONTROLS"
      ]
    }
  }
}
