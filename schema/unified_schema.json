{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Universal Form Schema",
  "type": "object",
  "patternProperties": {
    "^frm.*FORM$": {
      "type": "object",
      "properties": {
        "FORM": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "type": { "type": "string", "enum": ["Panel", "Dialog", "Frame"] },
            "title": { "type": "string" },
            "layout": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["responsive", "master_detail", "legacy"] },
                "border": { "type": "integer", "minimum": 0 },
                "gap": { "type": "integer", "minimum": 0 },
                "breakpoint": { "type": "integer", "minimum": 320 },
                "scrollbar_allowance": { "type": "integer", "minimum": 0 },
                "master_min_width": { "type": "integer", "minimum": 100 },
                "detail_min_width": { "type": "integer", "minimum": 100 },
                "master_proportion": { "type": "integer", "minimum": 1 },
                "detail_proportion": { "type": "integer", "minimum": 1 }
              },
              "required": ["type"]
            },
            "table": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "fields": {
                  "type": "array",
                  "items": { "type": ["string", "object"] }
                },
                "orderby": { "type": "string" },
                "sort": { "type": "string" },
                "condition": { "type": "string" }
              },
              "required": ["name", "fields"]
            },
            "tablename": { "type": "string" },
            "subformtype": { "type": "string" },
            "stylelist": {
              "type": "array",
              "items": { "type": "string" }
            },
            "style": {
              "type": "array",
              "items": { "type": "string" }
            },
            "stylestr": { "type": "string" },
            "posch": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "sizech": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            },
            "controls": {
              "type": "array",
              "items": { "type": "string" }
            },
            "readonlyfields": {
              "type": "array",
              "items": { "type": "string" }
            },
            "theme": { "type": "string", "enum": ["churchmanager"] },
            "linkedform": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "title": { "type": "string" },
                    "table": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "fields": {
                          "type": "array",
                          "items": { "type": "string" }
                        },
                        "orderby": { "type": "string" },
                        "condition": { "type": "string" }
                      }
                    },
                    "controls": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "readonlyfields": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "fillonblank": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "bindbtn": { "type": "string" },
                    "posch": {
                      "type": "array",
                      "items": { "type": "number" }
                    }
                  }
                }
              }
            },
            "nodataDB": { "type": "boolean" }
            ,"security": {
              "type": "object",
              "properties": {
                "open": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
                "create": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
                "update": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
                "delete": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
                "report": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" }
              },
              "additionalProperties": false
            }
          },
          "required": ["name", "type", "title"]
        },
        "CONTROLS": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "StaticBox", "StaticText", "MultiLine", "TextCtrl",
                    "TextNumber", "Currency", "Float", "JSON", "ComboBox",
                    "ListCtrl", "ListCtrlID", "CheckBox", "CheckListBox",
                    "CheckListEdit", "Button", "DataViewListCtrl", "DateTime",
                    "DatePickerCtrl", "TimePickerCtrl", "CalendarCtrl",
                    "FilePickerCtrl", "ImagePickerCtrl", "HTMLCtrl"
                  ]
                },
                "name": { "type": "string" },
                "label": { "type": "string" },
                "tooltip": { "type": "string", "minLength": 1 },
                "fontface": { "type": "string", "minLength": 1 },
                "fontsize": { "type": "integer", "minimum": 6, "maximum": 72 },
                "bold": { "type": "boolean" },
                "italic": { "type": "boolean" },
                "foreground": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                "conditionalformat": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": { "type": "string", "minLength": 1 },
                      "operator": {
                        "type": "string",
                        "enum": ["equals", "not_equals", "empty", "not_empty", "truthy", "falsy", "contains", "greater_than", "less_than"]
                      },
                      "value": {},
                      "style": {
                        "type": "string",
                        "enum": ["normal", "complete", "incomplete", "customized", "omitted", "inactive", "warning"]
                      }
                    },
                    "required": ["field", "style"],
                    "additionalProperties": false
                  }
                },
                "required": { "type": "boolean" },
                "maxlength": { "type": "integer", "minimum": 1 },
                "maxlengthmessage": { "type": "string", "minLength": 1 },
                "maxbytes": { "type": "integer", "minimum": 1 },
                "maxpixels": { "type": "integer", "minimum": 1 },
                "allowupscale": { "type": "boolean" },
                "allowall": { "type": "boolean" },
                "alllabel": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 },
                "wildcard": { "type": "string", "minLength": 1 },
                "layout": {
                  "type": "object",
                  "properties": {
                    "row": { "type": "integer", "minimum": 0 },
                    "column": { "type": "integer", "minimum": 0 },
                    "row_span": { "type": "integer", "minimum": 1 },
                    "column_span": { "type": "integer", "minimum": 1 },
                    "expand": { "type": "boolean" },
                    "proportion": { "type": "integer", "minimum": 0 },
                    "hidden": { "type": "boolean" }
                    ,"pane": { "type": "string", "enum": ["master", "detail"] }
                  }
                },
                "posch": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                },
                "sizech": {
                  "type": "array",
                  "items": { "type": "number" }
                },
                "stylelist": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "readonly": { "type": "boolean" },
                "norecorddata": { "type": "boolean" },
                "defaultvalue": { "type": ["string", "number", "boolean", "null"] },
                "value": { "type": ["string", "number", "boolean", "null"] },
                "list": { "type": "boolean" },
                "singleselect": { "type": "boolean" },
                "linkedfield": { "type": "string" },
                "savestyle": { "type": "string" },
                "format": { "type": "string" },
                "column": {
                  "type": "array",
                  "items": {
                    "type": ["array", "object"],
                    "items": [
                      { "type": "string" },
                      { "type": "number" }
                    ]
                  }
                },
                "columnSQL": { "type": "string" },
                "action": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "security": {
                  "type": "object",
                  "properties": {
                    "view": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
                    "edit": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
                    "invoke": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" }
                  },
                  "additionalProperties": false
                },
                "lookupchoices": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "fields": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "orderby": { "type": "string" },
                    "condition": { "type": "string" },
                    "ID": { "type": "string" },
                    "allowblank": { "type": "boolean" },
                    "blanklabel": { "type": "string", "minLength": 1 },
                    "allowall": { "type": "boolean" },
                    "alllabel": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "required": ["type", "name", "posch"]
            }
          }
        }
      },
      "required": ["FORM", "CONTROLS"]
    }
  },
  "additionalProperties": false
}
