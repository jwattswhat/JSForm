include LICENSE
include README.md
include CONTRIBUTING.md
include SECURITY.md
include SUPPORT.md
include JSFORM_ENHANCEMENTS.md
include requirements.txt
include run_jsform_tests.py
include accept_distribution.py
include jsformschema.json
recursive-include Documentation *.md
recursive-include examples *.py *.md *.json *.sql *.cmd
recursive-include tests *.py *.md
recursive-include Forms *.json
recursive-include schema *.json
prune BackupDB
prune DevelopmentTesting
global-exclude Log.txt
global-exclude *.py[cod]
global-exclude __pycache__
